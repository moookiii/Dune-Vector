.compendium-root {
    flex-direction: column;
}

.compendium-window {
    flex-direction: column;
    overflow: hidden;
}

.compendium-separator {
    flex-shrink: 0;
    flex-direction: row;
    overflow: hidden;
}

.compendium-progress-fill {
    height: 100%;
    width: 0;
    transition-property: width;
    transition-duration: 0.25s;
    transition-timing-function: ease-out;
}

.compendium-header {
    flex-direction: row;
    align-items: center;
}

.compendium-header-titles {
    flex-grow: 1;
    flex-direction: column;
    justify-content: center;
}

.compendium-progress,
.compendium-close {
    margin-top: 0;
    margin-bottom: 0;
    padding-top: 0;
    padding-bottom: 0;
    -unity-text-align: middle-center;
}

.compendium-title,
.compendium-subtitle,
.compendium-tab-label,
.compendium-card-title,
.compendium-card-metadata,
.compendium-detail-title,
.compendium-detail-metadata,
.compendium-detail-description {
    -unity-text-align: middle-left;
}

.compendium-title {
    letter-spacing: 2px;
}

.compendium-progress {
    letter-spacing: 1px;
}

.compendium-tabs {
    flex-direction: row;
}

.compendium-tab {
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    position: relative;
    overflow: hidden;
    transition-property: background-color;
    transition-duration: 0.12s;
}

.compendium-tab-label {
    letter-spacing: 1px;
}

.compendium-tab-underline {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
}

.compendium-content {
    flex-grow: 1;
    flex-direction: row;
    min-height: 0;
}

.compendium-grid {
    flex-grow: 1;
    min-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.compendium-grid .unity-scroller__high-button,
.compendium-grid .unity-scroller__low-button {
    display: none;
}

.compendium-grid-row {
    flex-direction: row;
}

.compendium-grid .unity-list-view__item,
.compendium-grid .unity-list-view__item:hover,
.compendium-grid .unity-list-view__item:checked,
.compendium-grid .unity-list-view__item--selected,
.compendium-grid .unity-list-view__item--selected:hover {
    background-color: rgba(0, 0, 0, 0);
}

.compendium-card {
    position: relative;
    overflow: hidden;
    padding: 0;
    transition-property: scale, background-color;
    transition-duration: 0.12s;
    transition-timing-function: ease-out;
}

.compendium-card.is-hovered {
    scale: 1.015;
}

.compendium-card-overlay {
    position: absolute;
    left: 0;
    right: 0;
    flex-direction: column;
    justify-content: space-between;
    align-items: flex-start;
}

.compendium-card-title,
.compendium-card-metadata {
    flex-grow: 0;
    flex-shrink: 0;
    align-self: flex-start;
    margin: 0;
    padding: 0;
    -unity-text-align: upper-left;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.85);
}

.compendium-card-metadata {
    letter-spacing: 1px;
}

.compendium-card-accent {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
}

.compendium-card-selection-marker {
    position: absolute;
    right: 0;
    top: 0;
    align-items: center;
    justify-content: center;
}

.compendium-locked {
    align-items: center;
    justify-content: center;
}

.compendium-contour {
    height: 1px;
    margin-top: 5px;
    margin-bottom: 5px;
    background-color: rgba(130, 160, 170, 0.7);
}

.compendium-locked-symbol {
    position: absolute;
    font-size: 28px;
    color: rgba(180, 196, 199, 0.72);
    -unity-text-align: middle-center;
}

.compendium-detail {
    flex-shrink: 0;
    flex-direction: column;
}

.compendium-detail-hero {
    position: relative;
    overflow: hidden;
}

.compendium-detail-title {
    margin-top: 18px;
    white-space: normal;
}

.compendium-chip-row {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    margin-top: 10px;
}

.compendium-chip {
    margin: 0;
    margin-right: 8px;
    letter-spacing: 1px;
    -unity-text-align: middle-center;
}

.compendium-detail-rule {
    width: 54px;
    height: 2px;
    margin-top: 14px;
    margin-bottom: 16px;
}

.compendium-detail-description {
    white-space: normal;
    -unity-paragraph-spacing: 12px;
}
