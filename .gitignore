# Unity project root .gitignore
# Keep under source control:
# - Assets/**
# - Packages/manifest.json
# - Packages/packages-lock.json
# - ProjectSettings/**
# - *.meta

# OS
.DS_Store
Thumbs.db
Desktop.ini

# Unity generated
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
.utmp/

# Strata assets that take up large amounts of storage space
Assets/Strata/Art/
Assets/Strata/Models/
tmp_video_review/
tmp/

# Unity logs / crash output
*.log
sysinfo.txt
mono_crash.*

# Profiling / captures
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Blender backup files
*.blend1
*.blend2
*.blend[0-9].meta
*.blend1.meta
*.blend2.meta

# IDE / editor local files
.vs/
.idea/
.consulo/
.gradle/
*.DotSettings.user

# Auto-generated solution / project files
ExportedObj/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity-generated meta sidecars for generated IDE/db files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Build artifacts
*.apk
*.aab
*.app
*.unitypackage
*.unitypackage.meta

# Crashlytics
crashlytics-build.properties

# Test runner generated scenes
InitTestScene*.unity*
/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*

# Addressables generated content
/ServerData
/[Aa]ssets/StreamingAssets/aa*
/[Aa]ssets/AddressableAssetsData/link.xml*
/[Aa]ssets/Addressables_Temp*
/[Aa]ssets/AddressableAssetsData/*/*.bin*

# Visual Scripting generated caches
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# Scene dependency cache
/[Aa]ssets/[Ss]ceneDependencyCache*

# Unity Rider plugin auto-generated by Unity
/[Aa]ssets/Plugins/Editor/JetBrains*

# Optional: uncomment if you use Asset Store Tools and do not want it tracked
# /[Aa]ssets/AssetStoreTools*

# Optional: uncomment if you want all local VS Code settings ignored
# .vscode/

!*.meta
fmod_editor.log

/Assets/Archanor/